(deffacts evaluation-questions

   (question
      (id 1)
      (area "Work Performance")
      (text "How effectively does the employee perform the main duties and responsibilities required by their position?")
      (options
         "Poor"
         "Fair"
         "Good"
         "Very Good"
         "Excellent"
      )
   )

   (question
      (id 2)
      (area "Work Performance")
      (text "How well does the employee organize and complete assigned work accurately and within the expected time?")
      (options
         "Poorly"
         "Below Expectations"
         "Meets Expectations"
         "Above Expectations"
         "Excellent"
      )
   )

   (question
      (id 3)
      (area "Communication & Teamwork")
      (text "How effectively does the employee communicate information, ideas, and concerns with coworkers and other people they work with?")
      (options
         "Very Ineffectively"
         "Ineffectively"
         "Adequately"
         "Effectively"
         "Very Effectively"
      )
   )

   (question
      (id 4)
      (area "Communication & Teamwork")
      (text "How well does the employee cooperate with coworkers and contribute to completing shared tasks and team responsibilities?")
      (options
         "Very Poorly"
         "Poorly"
         "Adequately"
         "Well"
         "Very Well"
      )
   )

   (question
      (id 5)
      (area "Compliance & Accountability")
      (text "How consistently does the employee follow workplace policies, procedures, instructions, and established standards when performing their duties?")
      (options
         "Rarely"
         "Sometimes"
         "Often"
         "Almost Always"
         "Always"
      )
   )

   (question
      (id 6)
      (area "Compliance & Accountability")
      (text "How reliably does the employee take responsibility for assigned duties and ensure that their work is completed as expected?")
      (options
         "Not Reliably"
         "Slightly Reliably"
         "Moderately Reliably"
         "Very Reliably"
         "Extremely Reliably"
      )
   )

   (question
      (id 7)
      (area "Problem Solving & Adaptability")
      (text "How effectively does the employee identify problems that affect their work and take appropriate action to resolve them?")
      (options
         "Very Ineffectively"
         "Ineffectively"
         "Adequately"
         "Effectively"
         "Very Effectively"
      )
   )

   (question
      (id 8)
      (area "Problem Solving & Adaptability")
      (text "How well does the employee adjust their approach when work requirements, priorities, procedures, or situations change?")
      (options
         "Very Poorly"
         "Poorly"
         "Adequately"
         "Well"
         "Very Well"
      )
   )

   (question
      (id 9)
      (area "Quality & Professionalism")
      (text "How consistently does the employee produce work that meets the expected standards for accuracy, completeness, and quality?")
      (options
         "Rarely"
         "Sometimes"
         "Often"
         "Almost Always"
         "Always"
      )
   )

   (question
      (id 10)
      (area "Quality & Professionalism")
      (text "How professionally does the employee conduct themselves when carrying out responsibilities and interacting with others in the workplace?")
      (options
         "Very Unprofessionally"
         "Unprofessionally"
         "Acceptably"
         "Professionally"
         "Very Professionally"
      )
   )
)